# Interactive shell init. Rendered by `yadm alt` from .zshrc##template.
#
# Environment and PATH live in ~/.zshenv, which zsh sources first and which
# sets ZDOTDIR to this directory. Do NOT source ~/.zshenv from here: zsh has
# already read it, and re-sourcing rebuilds PATH a second time.

# Powerlevel10k instant prompt. Must stay near the top; anything that may
# print or prompt has to go above it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

for _mod in plugins options aliases functions; do
  [[ -r "$ZDOTDIR/$_mod.zsh" ]] && source "$ZDOTDIR/$_mod.zsh"
done
unset _mod

{% if yadm.os == "Darwin" %}
# --- macOS ---
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
alias clean-derived-data="rm -rf ~/Library/Developer/Xcode/DerivedData"
{% endif %}
{% if yadm.os == "Linux" %}
# --- Linux ---
export MANPAGER="sh -c 'col -bx | batcat -l man -p'"
alias bat="batcat"
{% endif %}

# --- External sources ---
# fzf ships its own shell integration; the old ~/.fzf.zsh came from a git-clone
# install and hardcoded an absolute username, so it broke on any other machine.
command -v fzf >/dev/null && source <(fzf --zsh)
[[ -f ~/.iterm2_shell_integration.zsh ]] && source ~/.iterm2_shell_integration.zsh
[[ -f "$ZDOTDIR/.p10k.zsh" ]] && source "$ZDOTDIR/.p10k.zsh"

# Generated by scripts/theme.sh. Must come AFTER .p10k.zsh, which opens with
# `unset -m 'POWERLEVEL9K_*'` and would wipe these overrides.
[[ -f "$ZDOTDIR/p10k-colors.zsh" ]] && source "$ZDOTDIR/p10k-colors.zsh"
[[ -f "$ZDOTDIR/fzf-colors.zsh" ]] && source "$ZDOTDIR/fzf-colors.zsh"

# Machine-specific, untracked. Anything with a path or token belongs here.
[[ -f "$ZDOTDIR/local.zsh" ]] && source "$ZDOTDIR/local.zsh"

# --- Runtimes ---
eval "$(mise activate zsh)"
# direnv after mise, so a project .envrc can still override a mise pin.
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
