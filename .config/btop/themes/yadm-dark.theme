# Generated by scripts/theme.sh — GitHub Dark
# Paired with theme_background = False in btop.conf, so the background stays
# the terminal's own and follows a light/dark flip immediately. Graph colours
# only change on restart; that is a btop limitation, not a bug here.
theme[main_bg]=""
theme[main_fg]="#adbac7"
theme[title]="#adbac7"
theme[hi_fg]="#539bf5"
theme[selected_bg]="#264f78"
theme[selected_fg]="#adbac7"
theme[inactive_fg]="#6c757f"
theme[graph_text]="#6c757f"
theme[meter_bg]="#161a20"
theme[proc_misc]="#b083f0"
theme[cpu_box]="#404750"
theme[mem_box]="#404750"
theme[net_box]="#404750"
theme[proc_box]="#404750"
theme[div_line]="#404750"
