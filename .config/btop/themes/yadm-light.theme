# Generated by scripts/theme.sh — GitHub Light
# Paired with theme_background = False in btop.conf, so the background stays
# the terminal's own and follows a light/dark flip immediately. Graph colours
# only change on restart; that is a btop limitation, not a bug here.
theme[main_bg]=""
theme[main_fg]="#1f2328"
theme[title]="#1f2328"
theme[hi_fg]="#0969da"
theme[selected_bg]="#add6ff"
theme[selected_fg]="#1f2328"
theme[inactive_fg]="#808386"
theme[graph_text]="#808386"
theme[meter_bg]="#e7e9eb"
theme[proc_misc]="#8250df"
theme[cpu_box]="#c0c3c6"
theme[mem_box]="#c0c3c6"
theme[net_box]="#c0c3c6"
theme[proc_box]="#c0c3c6"
theme[div_line]="#c0c3c6"
