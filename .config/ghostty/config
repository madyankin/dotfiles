# Ghostty. Tracked; the two theme files it names are generated by
# scripts/theme.sh and gitignored.
#
# This one line is why Ghostty replaced iTerm2 as the daily driver: Ghostty
# watches the macOS appearance itself and re-applies the whole palette to
# RUNNING surfaces, which is what makes every ANSI-index-based tool below it
# (tmux, fzf, p10k, ls) follow a light/dark flip with no daemon.
theme = light:yadm-light,dark:yadm-dark

# App icon, tinted from the palette. `?` makes the include optional, so the
# config still loads on a machine where the theme has not been rendered yet.
config-file = ?icon.conf

font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15

# iTerm2's profile had Vertical Spacing 1.15 / Horizontal 1.0, so the lines sat
# 15% further apart than the font's natural metrics. This reproduces that.
adjust-cell-height = 15%

# Ghostty's own TERM is xterm-ghostty, whose terminfo is absent on every
# remote host and inside older tmux — ssh and clear then break in confusing
# ways. Override until that terminfo is everywhere.
term = xterm-256color

# No titlebar, no window title text. `hidden` keeps the native window border
# and rounded corners (unlike window-decoration = none) but, per Ghostty's own
# docs, the traffic-light buttons are always hidden in this mode — close with
# Cmd+W / Cmd+Q, move the window by dragging the terminal area.
#
# If you want the buttons back and only the TEXT gone, use instead:
#   macos-titlebar-style = transparent
#   title = " "
macos-titlebar-style = hidden

window-save-state = always
window-padding-x = 8
window-padding-y = 6
macos-option-as-alt = true
copy-on-select = clipboard
confirm-close-surface = false
# Horizontal (underline) cursor.
#
# `no-cursor` is required, not optional: with the `cursor` shell-integration
# feature on, the shell forces a BAR at every prompt "regardless of this
# configuration" (Ghostty's own docs), so cursor-style would only apply while
# a command was running.
cursor-style = underline
cursor-style-blink = false

# Making the underline cursor bolder.
#
# Ghostty has no underline-cursor-specific thickness option:
# `adjust-cursor-thickness` documents itself as applying to "the bar cursor and
# outlined rect cursor" only. The underline cursor is drawn from the FONT's
# underline metric, so that is the knob — with the side effect that genuinely
# underlined text gets thicker too.
#
# These adjustments are DELTAS, not absolutes: 200% means "increase by 200%",
# i.e. three times the font's natural underline. Values are integers or
# percentages only — `1px` is invalid and Ghostty drops it silently.
adjust-underline-thickness = 200%
# Nudge it down 1px so the thicker bar does not crowd the glyph baseline.
adjust-underline-position = 1
shell-integration-features = no-cursor,sudo,title

# Keep the surface transparent-ish like the previous setup, without losing
# contrast in light mode.
background-opacity = 1.0
