# Essentials: CLI tools, fonts, editors, everyday apps.
# Transcribed 1:1 from homebrew.sh install_essentials().

# --- CLI ---
brew "bat"
brew "git-delta"      # canonical name; "delta" is an alias and never matches brew list
brew "git"
brew "gnupg"
brew "fd"
brew "fzf"            # was a ~/.fzf git clone with an absolute username in it
brew "jq"
brew "htop"
brew "mas"
brew "midnight-commander"  # canonical name; "mc" is an alias
brew "mise"
brew "ruby"           # ~/.zshenv pins /opt/homebrew/opt/ruby/bin; asdf used to supply ruby
brew "pinentry-mac"
brew "powerlevel10k"
brew "speedtest-cli"
brew "yadm"

# --- Fonts ---
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"

# --- Terminal ---
cask "ghostty"

# --- Productivity ---
cask "alfred"

# --- Editors ---
brew "neovim"
cask "visual-studio-code"

# --- Agents ---
cask "claude-code"    # was the npm global @anthropic-ai/claude-code

# --- GUIs (Omarchy parity) ---
cask "obsidian"
cask "iina"           # covers Omarchy's mpv
cask "localsend"      # AirDrop-alike that also talks to Linux and Android
cask "signal"

# --- Mac App Store ---
mas "Amphetamine", id: 937984704
mas "The Unarchiver", id: 425424353
mas "Hidden Bar", id: 1452453066
mas "Dark Reader", id: 1438243180
mas "Untrap", id: 1637438059
mas "DaisyDisk", id: 411643860
mas "Things 3", id: 904280696
mas "SponsorBlock for YouTube", id: 1573461917
mas "DeArrow for YouTube", id: 6451469297
