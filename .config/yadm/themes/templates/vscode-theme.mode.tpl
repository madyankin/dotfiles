    "statusBar.background": "{{BACKGROUND_DARKER}}",
    "statusBar.foreground": "{{FOREGROUND_DIM}}",
    "statusBar.border": "{{BORDER}}",
    "statusBarItem.remoteBackground": "{{ACCENT}}",
    "titleBar.activeBackground": "{{BACKGROUND_DARKER}}",
    "titleBar.activeForeground": "{{FOREGROUND}}",
    "titleBar.inactiveBackground": "{{BACKGROUND_DARKER}}",
    "titleBar.inactiveForeground": "{{FOREGROUND_DIM}}",
    "tab.activeBackground": "{{BACKGROUND}}",
    "tab.activeForeground": "{{FOREGROUND}}",
    "tab.inactiveBackground": "{{BACKGROUND_DARKER}}",
    "tab.inactiveForeground": "{{FOREGROUND_DIM}}",
    "tab.activeBorderTop": "{{ACCENT}}",
    "tab.border": "{{BORDER}}",
    "editorGroupHeader.tabsBackground": "{{BACKGROUND_DARKER}}",
