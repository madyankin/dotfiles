    "terminal.ansiRed": "{{ANSI_01}}",
    "terminal.ansiGreen": "{{ANSI_02}}",
    "terminal.ansiYellow": "{{ANSI_03}}",
    "terminal.ansiBlue": "{{ANSI_04}}",
    "terminal.ansiMagenta": "{{ANSI_05}}",
    "terminal.ansiCyan": "{{ANSI_06}}",
    "terminal.ansiWhite": "{{ANSI_07}}",
