    "editorIndentGuide.activeBackground1": "{{ACCENT}}",
    "editorBracketMatch.border": "{{ACCENT}}",
    "editorError.foreground": "{{SYN_ERROR}}",
    "editorWarning.foreground": "{{SYN_WARNING}}",
    "editorInfo.foreground": "{{ACCENT}}",
    "editorGutter.addedBackground": "{{SYN_DIFF_ADD}}",
    "editorGutter.modifiedBackground": "{{SYN_DIFF_CHANGE}}",
    "editorGutter.deletedBackground": "{{SYN_DIFF_DEL}}",
    "diffEditor.insertedTextBackground": "{{SYN_DIFF_ADD}}22",
