    "quickInput.background": "{{BACKGROUND_LIGHTER}}",
    "input.background": "{{BACKGROUND_LIGHTER}}",
    "input.border": "{{BORDER}}",
    "focusBorder": "{{ACCENT}}",
    "button.background": "{{ACCENT}}",
    "button.foreground": "{{BACKGROUND}}",
    "badge.background": "{{ACCENT}}",
    "badge.foreground": "{{BACKGROUND}}",
    "scrollbarSlider.background": "{{BORDER}}66",
    "widget.border": "{{BORDER}}",
    "menu.background": "{{BACKGROUND_LIGHTER}}",
    "menu.foreground": "{{FOREGROUND}}",
    "dropdown.background": "{{BACKGROUND_LIGHTER}}",
    "gitDecoration.modifiedResourceForeground": "{{SYN_DIFF_CHANGE}}",
    "gitDecoration.deletedResourceForeground": "{{SYN_DIFF_DEL}}",
    "gitDecoration.untrackedResourceForeground": "{{SYN_DIFF_ADD}}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{SYN_COMMENT}}", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "constant.other.symbol"],
      "settings": { "foreground": "{{SYN_STRING}}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "{{SYN_CONSTANT}}" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "{{SYN_KEYWORD}}" } },
    { "scope": ["keyword.operator"],
      "settings": { "foreground": "{{SYN_OPERATOR}}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "{{SYN_FUNCTION}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "{{SYN_TYPE}}" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "{{SYN_VARIABLE}}" } },
    { "scope": ["variable.parameter"],
      "settings": { "foreground": "{{FOREGROUND}}" } },
    { "scope": ["variable.language", "variable.other.constant"],
      "settings": { "foreground": "{{SYN_KEYWORD}}", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag"],
      "settings": { "foreground": "{{SYN_KEYWORD}}" } },
    { "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "{{SYN_TYPE}}" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "{{SYN_VARIABLE}}" } },
    { "scope": ["markup.heading"],
      "settings": { "foreground": "{{ACCENT}}", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"],
      "settings": { "foreground": "{{ACCENT_ALT}}" } },
    { "scope": ["markup.inserted"],
      "settings": { "foreground": "{{SYN_DIFF_ADD}}" } },
    { "scope": ["markup.deleted"],
      "settings": { "foreground": "{{SYN_DIFF_DEL}}" } },
    { "scope": ["markup.changed"],
      "settings": { "foreground": "{{SYN_DIFF_CHANGE}}" } },
    { "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{SYN_ERROR}}" } }
  ]
}
