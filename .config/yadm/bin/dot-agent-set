#!/usr/bin/env bash
# dot:summary=choose the default coding agent (no argument opens a picker)
set -uo pipefail
DOT_ROOT="${DOT_ROOT:-$HOME/.config/yadm}"
source "$DOT_ROOT/lib/common.sh"
DEFAULT_FILE="$DOT_ROOT/agents/default"

name="${1:-}"
if [[ -z "$name" ]]; then
  # Only offer agents that are actually installed; the list marks the rest.
  name="$("$DOT_ROOT/bin/dot-agent" list \
    | awk '$2 == "installed" { print $1 }' \
    | sed 's/^[*] //' | pick_one agent)"
  [[ -z "$name" ]] && { echo "  nothing selected"; exit 0; }
fi
case "$name" in
  claude|codex|goose|opencode|gemini|cursor|pi) ;;
  *) err "unknown agent: $name"; exit 1 ;;
esac
mkdir -p "$(dirname "$DEFAULT_FILE")"
printf '%s\n' "$name" > "$DEFAULT_FILE"
ok "default agent: $name"
