#!/usr/bin/env bash
# dot:summary=check the machine against the config, report drift
#
# Convergence, not migrations. Every setup script in this repo converges to a
# desired state; a doctor is the read-only half of that idea. It is also the
# only thing that catches DRIFT — a crontab commented out by hand, an app
# uninstalled from under its config, a shim war between two version managers —
# none of which a run-once migration runner would ever notice.
set -uo pipefail

DOT_ROOT="${DOT_ROOT:-$HOME/.config/yadm}"
export DOT_ROOT
# shellcheck source=/dev/null
source "$DOT_ROOT/lib/common.sh"

FIX=""
ONLY=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --fix)  FIX=1; shift ;;
    --only) ONLY="$2"; shift 2 ;;
    -h|--help)
      cat <<'EOT'
dot doctor [--fix] [--only <name>]

  --fix    offer the destructive one-shots a check suggests (asks first)
  --only   run just the check whose filename contains <name>
EOT
      exit 0 ;;
    *) err "unknown option: $1"; exit 2 ;;
  esac
done

fail=0
warned=0

for check in "$DOT_ROOT"/doctor.d/*.sh; do
  [[ -x "$check" ]] || continue
  name="$(basename "$check" .sh)"
  [[ -n "$ONLY" && "$name" != *"$ONLY"* ]] && continue
  desc="$(sed -n 's/^# dot:check=//p' "$check" | head -1)"
  header "${name#*-}${desc:+ — $desc}"
  # Each check is its own process but reuses the helpers, hence the source.
  ( source "$DOT_ROOT/lib/common.sh"; source "$check" )
  rc=$?
  [[ $rc -ne 0 ]] && fail=$((fail+1))
done

header "summary"
if [[ $fail -eq 0 ]]; then
  ok "no failing checks"
else
  err "$fail check group(s) reported a failure"
fi

if [[ -n "$FIX" ]]; then
  header "fixes"
  # Offered as a multi-select rather than a chain of y/N prompts: you see
  # every available fix at once and choose, instead of answering questions
  # one at a time without knowing what comes next.
  #
  # These are the destructive one-shots a convergence step cannot do. They
  # need no state file: once applied, the detector stops firing.
  offers=""
  add_offer() { offers="${offers}$1"$'\n'; }

  if [[ -d "$HOME/.asdf" ]] && have mise; then
    add_offer "remove-asdf	uninstall the asdf formula and move ~/.asdf aside"
  fi
  if [[ -d "$HOME/.fzf" ]] && brew list --formula 2>/dev/null </dev/null | grep -qx fzf; then
    add_offer "remove-fzf-clone	move the ~/.fzf git clone aside (fzf comes from Homebrew)"
  fi
  if ! launchctl print "gui/$UID/name.madyankin.dotfiles.sync" >/dev/null 2>&1; then
    add_offer "install-sync	load the launchd agent that commits and pushes every 2h"
  fi
  if [[ "$(yadm -C "$HOME" stash list 2>/dev/null | wc -l | tr -d ' ')" != "0" ]]; then
    add_offer "show-stash	show what the leftover autostash contains (does not drop it)"
  fi

  offers="$(printf '%s' "$offers" | grep -v '^$' || true)"
  if [[ -z "$offers" ]]; then
    ok "nothing to offer"
  else
    chosen="$(printf '%s\n' "$offers" | awk -F'\t' '{printf "%-18s %s\n", $1, $2}' \
              | pick_many "fixes to apply")"
    if [[ -z "$chosen" ]]; then
      ok "no fixes applied"
    else
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        case "${line%% *}" in
          remove-asdf)
            run brew uninstall asdf
            run mv "$HOME/.asdf" "$HOME/.asdf.removed"
            ;;
          remove-fzf-clone)
            run mv "$HOME/.fzf" "$HOME/.fzf.removed"
            [[ -f "$HOME/.fzf.zsh" ]] && run mv "$HOME/.fzf.zsh" "$HOME/.fzf.zsh.removed"
            ;;
          install-sync)
            note "this commits and pushes your dotfiles unattended every 2 hours"
            run "$DOT_ROOT/scripts/cron.sh"
            ;;
          show-stash)
            yadm -C "$HOME" stash show --stat 'stash@{0}' | sed 's/^/    /'
            note "drop it yourself with: yadm stash drop"
            ;;
        esac
      done <<<"$chosen"
    fi
  fi
fi

exit $(( fail > 0 ))
