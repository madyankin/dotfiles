#!/usr/bin/env bash
# dot:summary=set the monospace family everywhere (no argument opens a picker)
set -uo pipefail
DOT_ROOT="${DOT_ROOT:-$HOME/.config/yadm}"
source "$DOT_ROOT/lib/common.sh"

FONT_FILE="$DOT_ROOT/themes/font.sh"
family="${1:-}"
size="${2:-}"

if [[ -z "$family" ]]; then
  family="$(/usr/bin/python3 "$DOT_ROOT/scripts/list-fonts.py" | pick_one font)"
  [[ -z "$family" ]] && { echo "  nothing selected"; exit 0; }
fi

/usr/bin/python3 - "$FONT_FILE" "$family" "$size" <<'PY'
import pathlib, re, sys
path, family, size = sys.argv[1], sys.argv[2], sys.argv[3]
p = pathlib.Path(path)
s = p.read_text()
s = re.sub(r'^FONT_FAMILY=.*$', 'FONT_FAMILY="%s"' % family, s, flags=re.M)
if size:
    s = re.sub(r'^FONT_SIZE=.*$', 'FONT_SIZE=%s' % size, s, flags=re.M)
p.write_text(s)
PY

ok "font family: $family${size:+ at ${size}pt}"
exec "$DOT_ROOT/scripts/theme.sh" render
