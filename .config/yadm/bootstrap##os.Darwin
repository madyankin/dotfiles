#!/bin/bash
#
# macOS bootstrap. Selected automatically by `yadm alt` via the ##os.Darwin
# suffix — no $OSTYPE branching needed.
set -e

# GitHub renders a README only from the repository root, but a README sitting
# in $HOME is clutter. Track it at the root and exclude it from the work tree.
if ! yadm sparse-checkout list &>/dev/null; then
  yadm sparse-checkout init --no-cone
  # --no-cone repeated on `set`, and the pattern anchored with a leading
  # slash. Without both, git stored it as `!README.md`, which is a
  # gitignore-style pattern matching README.md at ANY depth — so every
  # README in a subdirectory silently refused to be tracked.
  yadm sparse-checkout set --no-cone '/*' '!/README.md'
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

log() { echo ""; echo "━━━ $1 ━━━"; }

log "macOS Defaults"
./scripts/macos.sh

log "Software"
./scripts/homebrew.sh

# Accept Xcode license (if Xcode is installed)
if [[ -d "/Applications/Xcode.app" ]]; then
  log "Xcode License"
  sudo xcode-select -s /Applications/Xcode.app/Contents/Developer
  sudo xcodebuild -license accept
fi

log "iTerm2"
./scripts/iterm.sh

log "CLI"
./scripts/bin.sh

log "Editors"
./scripts/editors.sh

log "ZSH"
./scripts/zsh.sh

log "Cron"
./scripts/cron.sh

log "Alfred"
./scripts/alfred.sh setup
/usr/bin/python3 ./scripts/alfred-dot-workflow.py

log "Agent configs"
./scripts/agents.sh

# After Alfred, because the render binds Alfred's light/dark theme pair.
log "Theme"
./scripts/theme.sh render

# Last: report anything the steps above could not fix. Never fatal.
log "Doctor"
./bin/dot doctor || true

echo ""
echo "✓ Bootstrap complete"
