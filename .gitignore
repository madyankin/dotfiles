# --- yadm repo hygiene (reorg 2026-09-14) ---
# Build artifacts and tool-generated state that must never enter the repo.
# The sync script uses a scoped `yadm add -A`, so these rules are load-bearing.
__pycache__/
*.pyc
*.bak
*.bak.[0-9]

# Skill build output
.config/agents/skills/dist/

# Tool-generated, machine-local
.config/vercel-plugin/
.config/iterm2/
.config/goose/skills/
# Codex system skills, managed by Codex itself
.config/agents/skills/.system/
# Claude system skills, synced down from claude.ai (docx/pdf/pptx/xlsx/...)
.config/agents/skills/synced/
# and the sync's own trash, where superseded copies of those skills land
.config/agents/skills/.trash/

# Per-machine agent config (deliberately not shared between machines)
/.claude/settings.json
/.claude/settings.local.json

# Tool-managed shell init
/.zprofile

# Machine-specific shell config (paths, tokens)
.config/zsh/local.zsh

# zsh runtime state. ZDOTDIR relocates these into .config/zsh, which the sync
# script stages with `add -A` — without these rules shell history would be
# committed and pushed.
.config/zsh/.zsh_history
.config/zsh/.zsh_sessions/
.config/zsh/.zcompdump
.config/zsh/.zcompdump-*
.config/zsh/.zcompdump.zwc

# Tool state and credentials next to configs that ARE tracked
.config/gh/hosts.yml
.config/zed/prompts/
.config/zed/conversations/
.config/zed/extensions/
.config/zed/db/

# --- Never commit, under any circumstances ---
# The yadm worktree is $HOME, so a mistaken `yadm add -A` at the repo root
# would otherwise sweep private keys and API tokens into a public repo.
/.ssh/
/.gnupg/
/.aws/
/.netrc
/.npmrc
/.docker/config.json
/.claude.json
/.claude.json.backup

# Wizard selection state — per-machine
.config/yadm/packages/.selection

# Files generated by `yadm alt` from ##os.* / ##template sources. yadm lists
# them in the repo's info/exclude, but the sync script's scoped `yadm add -A`
# overrides that, so they need a real ignore rule or every run commits them.
.config/yadm/bootstrap
.config/zsh/.zshrc

# --- Theme engine (scripts/theme.sh) ---
# Palettes and templates under .config/yadm/themes/ ARE tracked; everything
# below is rendered output or per-machine state.
.config/yadm/themes/.active
.config/yadm/themes/.background
.config/yadm/themes/.terminal-imported
.config/yadm/themes/*/generated/
.config/ghostty/themes/yadm-*
.config/ghostty/icon.conf
.config/btop/themes/yadm-*.theme
.config/htop/htoprc.light
.config/htop/htoprc.dark
.config/tmux/theme.conf
.config/zsh/p10k-colors.zsh
.config/zsh/fzf-colors.zsh
.config/nvim/lua/yadm-theme/
.config/zed/themes/yadm.json
.config/yadm/editors/themes/

# --- Machine-local runtime state ---
# launchd agents are rendered from .config/yadm/launchd/*.template ($HOME does
# not expand inside a plist, so a literal one would bake in an absolute path).
/Library/LaunchAgents/
.local/state/dot/

# Retired in place rather than deleted, so they can come back if needed.
.asdf.removed/
.fzf.removed/
.fzf.zsh.removed
.fzf.bash.removed
.tool-versions.disabled

# --- Alfred ---
# The complete preference bundle lives in .config/yadm/alfred/ (Alfred's sync
# folder points there), but only part of it is tracked.
#
# Machine-specific: Alfred keeps per-machine hotkeys and appearance here.
.config/yadm/alfred/Alfred.alfredpreferences/preferences/local/
# Third-party workflows are reinstalled from workflows.txt rather than vendored;
# own workflows (no `webaddress` in info.plist) are re-included below.
.config/yadm/alfred/Alfred.alfredpreferences/workflows/*
!.config/yadm/alfred/Alfred.alfredpreferences/workflows/user.workflow.CF70B6B1-0418-4CD8-A46E-0819B46E5920/
# The `dot` workflow is GENERATED by scripts/alfred-dot-workflow.py, so its
# info.plist is reviewable and cannot drift from the CLI. It gets the second
# negation; every further own-workflow needs its own line (alfred.sh warns).
!.config/yadm/alfred/Alfred.alfredpreferences/workflows/user.workflow.D07F11E5-0000-4000-8000-000000000001/
# Never track a workflow's settings file — the OpenAI workflow stores a
# plaintext API key in one. This rule comes last so it applies inside the
# re-included directories too.
.config/yadm/alfred/Alfred.alfredpreferences/workflows/*/prefs.plist
